# Upload this file with the "Upload .env file" button on the Environment Variables step,
# then compare against GET /env. The parser is dotenv; each line below checks one rule.
UPLOAD_PLAIN=plain-value
UPLOAD_QUOTED="value with spaces"
UPLOAD_SINGLE_QUOTED='single quoted #not-a-comment'
UPLOAD_WITH_EQUALS=a=b=c
UPLOAD_EMPTY=
UPLOAD_URL=https://example.com/path?x=1&y=2
UPLOAD_INLINE_COMMENT=keep-this # dropped-by-parser
UPLOAD_MULTILINE="line one
line two"
export UPLOAD_EXPORTED=export-prefix-stripped
UPLOAD_SECRET_TOKEN=should-be-masked-in-/env
HEALTH_PATHS=/health,/healthz,/custom/ping
